{
  "description": "Mark tracked reproducibility passport claims stale after source or output edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claim-reconcile.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
